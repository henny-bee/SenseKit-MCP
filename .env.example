# SenseKit-MCP settings. Copy to .env, fill in, never commit .env.
# One KEY=VALUE per line. Comments go on their own line. Empty = default.
# Use absolute paths. Every variable is explained in docs/configuration.md.

# 1. Qlik server: host name only, no https://
QSEOW_HOST=sense.example.com

# 2. Login: choose one mode, then fill in only that mode's block
#    windows     = your Windows account (easiest: no certificates)
#    jwt         = a token through a JWT virtual proxy
#    certificate = client certificates exported from the QMC
QSEOW_AUTH_MODE=windows

# windows: DOMAIN\user, and the password or a path to a file holding it
QSEOW_USERNAME=
QSEOW_PASSWORD=
QSEOW_PASSWORD_PATH=

# jwt: the token, or a path to a file holding it
QSEOW_JWT=
QSEOW_JWT_PATH=

# certificate: PEM files from the QMC (if set in another mode, they also enable the user-session tools)
QSEOW_CERT_PATH=
QSEOW_CERT_KEY_PATH=
QSEOW_CERT_PASSPHRASE=
# certificate: the user the calls run as (empty = INTERNAL\sa_repository)
QSEOW_CERT_USER_DIRECTORY=
QSEOW_CERT_USER_ID=

# 3. What the server may do
# Tool groups: analyst, developer, admin
QSEOW_TOOL_GROUPS=analyst,developer,admin
# true = also offer write tools (build sheets, reload, delete, ...)
QSEOW_ALLOW_MUTATIONS=false

# 4. Optional: only if your site differs from the defaults
# Virtual proxy prefix (empty = "jwt" in jwt mode, none in windows mode)
QSEOW_VP_PREFIX=
# Ports (empty = default): proxy 443, QRS 4242, engine 4747, proxy service 4243
QSEOW_PROXY_PORT=
QSEOW_QRS_PORT=
QSEOW_ENGINE_PORT=
QSEOW_QPS_PORT=
# Root CA file (PEM) when the server's certificate is not trusted by default
QSEOW_ROOT_CERT_PATH=
# false only for a lab server with a self-signed certificate
QSEOW_TLS_VERIFY=true
# Browser for render_sheet: msedge, chrome or a path (empty = msedge on Windows)
QSEOW_BROWSER=
