# ---------------------------------------------------------------------------
# SenseKit-MCP configuration. Copy to .env and fill in. NEVER commit .env.
# The server reads ./.env, or the file named by QSEOW_ENV_PATH. Variables
# already set in the environment (e.g. your MCP client's env block) win.
# Full reference: docs/configuration.md
#
# Format: one KEY=VALUE per line, comments on their OWN line. Everything after
# "=" is the value, including spaces and a trailing "# ..." comment. Quotes
# are optional; backslashes are literal. An empty value means "not set": the
# default applies. Use absolute paths: relative ones resolve against the
# directory the MCP client starts the server in, not this file's directory.
# ---------------------------------------------------------------------------

# --- Site ---
# Hostname, no scheme
QSEOW_HOST=sense.example.com
# QRS direct (certificate mode)
QSEOW_QRS_PORT=4242
# Engine direct (certificate mode)
QSEOW_ENGINE_PORT=4747
# Proxy (jwt and windows mode)
QSEOW_PROXY_PORT=443
# Proxy Service REST (session tools; certificate-only API)
QSEOW_QPS_PORT=4243

# --- Auth: certificate | jwt | windows ---
# certificate: service-to-service via QMC-exported client certs on 4242/4747.
#              Full tool coverage (REST + engine). Recommended for servers.
# jwt:         via a JWT virtual proxy on 443. Signed, expiring, per-user —
#              preferred where an end-user identity must be carried.
#              NOTE: engine WebSocket through a virtual proxy is subject to
#              Qlik's CSWSH protection, handled automatically; see
#              docs/authentication.md.
# windows:     your Windows account, through the hub's login page (no certs,
#              no Qlik admin needed). Acts as that user.
# Set the mode, then fill in only that mode's section below.
QSEOW_AUTH_MODE=certificate

# Root CA (PEM): trusted on every TLS connection in EVERY mode (also the proxy
# in jwt and windows mode). Set it instead of disabling QSEOW_TLS_VERIFY.
# The file must exist once a path is set, e.g. /absolute/path/certs/root.pem
QSEOW_ROOT_CERT_PATH=

# --- certificate mode ---
# Paths to the QMC-exported PEM certs (never commit these files), e.g.
# /absolute/path/certs/client.pem and /absolute/path/certs/client_key.pem.
# Required in certificate mode. In the other modes they are loaded whenever
# both are set, so leave them empty unless you have the files; jwt mode uses
# them for the QPS session tools (the Proxy Service REST API only speaks
# certificate auth).
QSEOW_CERT_PATH=
QSEOW_CERT_KEY_PATH=
QSEOW_CERT_PASSPHRASE=
# Identity asserted on QRS calls in certificate mode
QSEOW_CERT_USER_DIRECTORY=INTERNAL
QSEOW_CERT_USER_ID=sa_repository

# --- jwt mode ---
# Virtual proxy prefix, as in https://host/jwt/. Empty = the mode's default:
# "jwt" in jwt mode, none (the default proxy) in windows mode. Set it in
# windows mode only to log in through a prefixed virtual proxy.
QSEOW_VP_PREFIX=
# The token itself, or the absolute path of a file containing it
QSEOW_JWT=
QSEOW_JWT_PATH=

# --- windows mode ---
# What you type on the Qlik login page: DOMAIN\user, one backslash, no quotes
QSEOW_USERNAME=
# Your password, or the absolute path of a file holding only the password.
# No trailing spaces (they become part of the password); quote the value only
# if the password itself starts or ends with a space.
# A rejected login is not retried until restart (no account lockout).
QSEOW_PASSWORD=
QSEOW_PASSWORD_PATH=

# --- Safety ---
# Which persona tool groups to expose: analyst, developer, admin (comma-separated)
QSEOW_TOOL_GROUPS=analyst,developer,admin
# Write tools (scripts, reloads, apps, tasks, sessions, sheets/objects,
# master items) are NOT REGISTERED unless this is true, so tools/list stays
# read-only by default. See docs/tools.md for which tools are gated.
QSEOW_ALLOW_MUTATIONS=false
# Set false ONLY for self-signed lab certs
QSEOW_TLS_VERIFY=true
